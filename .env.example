# Copia este archivo como .env y llena tus valores. El archivo .env NO se sube a GitHub.

# Clave para firmar las sesiones (inicio de sesión). Escribe cualquier texto largo y secreto.
SECRET_KEY=escribe-aqui-un-texto-largo-y-secreto

# Clave de Gemini: créala gratis en https://aistudio.google.com/apikey
# Si la dejas vacía, la app funciona en "modo simulado" con respuestas de ejemplo.
GEMINI_API_KEY=

# Modelo de Gemini y modelo de respaldo (se usa solo si el principal está saturado o sin cuota).
# Para ver qué modelos puede usar tu clave: python probar_gemini.py
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_RESPALDO=gemini-3.5-flash-lite

# true = no llamar a Gemini aunque haya clave (útil para ensayar la demo sin gastar cuota).
GEMINI_MOCK=false

# false = ocultar las cuentas de demostración en la pantalla de "Entrar".
MOSTRAR_CUENTAS_DEMO=true
